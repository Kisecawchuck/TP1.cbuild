#!/bin/bash

TESTES=(. testes/projeto_com_erro testes/projeto_sem_c testes/projeto_valido testes/ep_aed)
FUNCOES=(build run rebuild info clean)

for t in ${TESTES[@]}; do
	echo "=== Teste $t ==="
	# gera cbuild.conf com PATH adequado
	printf "# Arquivo de configuração para o cbuild\n
	# define diretório de execução do cbuild\n
	CBUILD_PATH='${t}'\n
	# define nome do executável\n
	TARGET=main\n
	# define compilador de C\n
	CC=gcc\n
	# define flags para o compilador de C\n
	CFLAGS='-Wall -Werror'\n" > cbuild.conf

	echo "Executando cbuild na raíz do projeto cbuild"
	sleep 1
	for f in ${FUNCOES[@]}; do
		echo "== Saída de $f: =="
		./cbuild $f
		if [[ $t = 'testes/ep_aed' && $f = 'run' ]]; then
			echo "= Saída da execução sem argumentos ="
			./cbuild $f
			echo "= Saída da execução com argumentos ="
			./cbuild -r "testes/ep_aed/textos/texto.txt" $f
		fi
		sleep 1
	done
	sleep 5
done
