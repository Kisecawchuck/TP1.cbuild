#!/bin/bash

TESTES=(. testes/projeto_com_erro testes/projeto_sem_c testes/projeto_valido testes/projeto_argumento)
FUNCOES=(build run rebuild info invalido clean)

for t in ${TESTES[@]}; do
	echo "=== Teste $t ==="
	echo "Executando cbuild na raíz do projeto cbuild"
    echo "================"
	# gera cbuild.conf com PATH adequado
	printf "# Arquivo de configuração para o cbuild\n
	# define diretório de execução do cbuild\n
	CBUILD_PATH='${t}'\n
	# define nome do executável\n
	TARGET=main\n
	# define compilador de C\n
	CC=gcc\n
	# define flags para o compilador de C\n
	CFLAGS='-Wall -Werror'\n" > cbuild.conf

    read -n 1 -s -r -p ""
	for f in ${FUNCOES[@]}; do
		echo "== Saída de $f =="
        case case $f in
            build)
                echo "= Modo padrão ="
                ./cbuild $f
                echo "= Modo debug ="
                ./cbuild -D $f
                ;;

            clean)
                echo "= Modo padrão ="
                ./cbuild $f
                echo "= Modo verboso ="
                ./cbuild -V $f
                ;;

            run)
                if [[ $t = 'testes/ep_aed' ]]; then
                    echo "= Saída da execução sem argumentos ="
                    ./cbuild $f
                    echo "= Saída da execução com argumentos ="
                    ./cbuild -r "texto muito legal" $f
                fi
                ;;
        esac
        read -n 1 -s -r -p ""
    done
done
