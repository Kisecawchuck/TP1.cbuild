#!/bin/bash

# podemos delegar uma função para cada pessoa, mas é importante que todos
# saibam como o código funciona por conta da demonstração;

# TODO: modo verboso 

# Lembrar: caso haja a utilização de flags nas funções implementadas, 
# principalmente se cada função requisitar um número de flags 
# diferentes, podemos chamar o comando $# que nos diz quantos argumentos
# foram passados na linha de comando. Isso será útil para diagnosticar 
# e evitar erros.

# Olha as flags passadas como argumentos e decide se o modo verboso ou debug será
# inicializado.

# Guarda o horário de incio da execução em segundos e nanosegundos
verbose='false'
debug='false'
while getopts "VD" flag; do
    case $flag in
        V) verbose='true' ;;
        D) debug='true' ;;
        *)
            echo "Opção inesperada ${flag}"
            exit
            ;;
    esac
done
# shifta os argumentos já utilizados
shift $((OPTIND - 1))

verbose_mode() {
    # Executa todo comando excrito após a chamada função dentro do código
    # em modo verboso (até que set +ev seja executado ou que o script termine)
    # caso a flag -V seja passada. Caso ocorra algum erro durante a execução, 
    # ela é interrompida.

    if [[ $verbose = 'true' ]]; then
        set -ev
    fi
}

debug_mode() {
    # Executa em modo debug todo comando chamado após a execuão dessa função
    # (até que set +ex seja executado ou qu e o script termine) caso a flag -D seja 
    # passada. Caso ocorra algum erro durante a execução, ela é interrompida.

    if [[ $debug = 'true' ]]; then
        set -ex
    fi
}

end_mode() {
    # termina modo verboso
    if [[ $verbose = 'true' ]]; then
        set +ev
    fi
    # termina modo debug
    if [[ $debug = 'true' ]]; then
        set +ex
    fi
}

# A cada chamada das funções principais, será determinado se o 
# o modo verboso será executado ou não.
if [[ $1 = 'build' ]]; then 
    verbose_mode
fi
cbuild_build() {
    # verifica se gcc está instalado
    if [[ ! $(command -v gcc) ]]; then
        echo "ERRO: GCC não está instalado"
        return 2
    fi

    # verifica se build é um diretório
    if [[ ! -d build ]]; then
        mkdir build
    fi
    # verifica se logs é um diretório
    if [[ ! -d logs ]]; then
        mkdir logs
    fi

    # verifica se há código-fonte no projeto
    if [[ ! -d src || -z $(compgen -G src/*.c) ]]; then
        echo "ERRO: não há arquivos .c no projeto"
        return 3
    fi

    # transformamos cada cada arquivo código-fonte em objeto
    SRCS="src/*.c"
    BUILD="build"
    for SRC in $SRCS; do
        if [[ -e $SRC ]]; then
            # remove a extensão .c e adiciona a extensão .o
            OBJ=${SRC%.*}.o
            # remove src/ e adiciona build/
            OBJ=$BUILD/${OBJ##*/}
            printf "$SRC:\n -o $OBJ\n"
            gcc -c $SRC -o $OBJ
        fi
    done

    # fixamos o executável final em build/main
    TARGET="${BUILD}/main"
    OBJS="${BUILD}/*.o"
    printf "main:\n -o $TARGET\n"
    gcc $OBJS -o $TARGET

    return 0
}
end_mode


if [[ $1 = 'run' ]]; then
    verbose_mode
fi
cbuild_run() {
    # TODO: passar flags para o run;
    if [[ -d ./build && -e ./build/main ]]; then
        build/main
    else
        echo "ERRO: ./build/main inexistente"
    fi
    return 0
}
end_mode


if [[ $1 = 'clean' ]]; then 
    verbose_mode
fi
cbuild_clean() {
    	echo "Apagando os seguintes arquivos:"
	echo "Pasta logs: $(ls logs)"
	
	echo "Pasta build: $(ls build)$"
	rm -f build/* logs/*
}
end_mode


if [[ $1 = 'rebuild' ]]; then
    verbose_mode
fi
cbuild_rebuild() {
    SRCS="src/*.c"
    BUILD="build"
    TARGET="$BUILD/main"
    OBJS="${BUILD}/*.o"

    ch='false'
    for SRC in $SRCS; do
        # remove a extensão .c e adiciona .o
        OBJ=${SRC%.*}.o
        # remove src/ e adiciona build/
        OBJ=$BUILD/${OBJ##*/}
        # compara o timestamp de cada arquivo fonte com o seu objeto,
        # se o código-fonte é mais novo que o objeto, houve uma alteração
        # após a compilação;
        if [[ $SRC -nt $OBJ ]]; then
            printf "$SRC:\n -o $OBJ\n"
            gcc -c $SRC -o $OBJ
            ch='true'
        fi
    done

    # só recompilar a main se houve mudança
    if [[ $ch == 'true' ]]; then 
        printf "main:\n -o $TARGET\n"
        # fixamos o executável final em build/main
        gcc $OBJS -o $TARGET
    fi

    return 0
}
end_mode

if [[ $1 = 'info' ]]; then 
    verbose_mode
fi
cbuild_info() {
	echo "=== Informações e Estatísticas do Projeto ==="

	# Conta arquivos .c e .h
	# O find procura no src arquivos regulares que terminam com .c (2>/dev/null serve para descartar mensagens de erro)
	# | wc -l conta as linhas (nesse caso quantos arquivos o find encontrou
	# qnt_c vai receber a saidá disso tudo, e não os comnado.
	# qnt_h é análogo ao qnt_c 
        local qtd_c=$(find src -type f -name "*.c" 2>/dev/null | wc -l)
	local qtd_h=$(find include -type f -name "*.h" 2>/dev/null | wc -l)
	echo "Arquivos fonte (.c): $qtd_c"
    	echo "Arquivos de cabeçalho (.h): $qtd_h"

	# Contagem de Linhas de Código em arquivos .c e .h
    	local linhas_c=0
    	local linhas_h=0

	if [ $qtd_c -gt 0 ]; then
        	# -exec executa o comando cat e os coloca tudo em único lugar {}
		# o + faz com que executemos o cat apenas uma única vez em todos os arquviso que estão no {}
		linhas_c=$(find src -name "*.c" -exec cat {} + 2>/dev/null | wc -l)
    	fi

	if [ $qtd_h -gt 0 ]; then
		# Análogo a linhas_c
		linhas_h=$(find include -name "*.h" -exec cat {} + 2>/dev/null | wc -l)
	fi

	local total_linhas=$((linhas_c + linhas_h))
	echo "Total de linhas de código (src + include): $total_linhas"
}
end_mode


gerar_logs(){
	
	nome_func="$1"
	nome_log="cbuild_$(date '+%d-%m-%Y_%H-%M-%S').txt"
	
	echo "Execução em $(date '+%d/%m/%Y') ás $(date '+%H:%M:%S')" > "$nome_log"
	echo "Comando Executado: $1 " >> "$nome_log"
	echo "Saída da execução: " >> "$nome_log"
	
	# Sem o descritor 3 redirecionado para &2, 
	# o rastro de set -x, com descritor padrão stderr(descritor 2), 
	# seria direcionado para o log na execução do comando com o tee
	# isso faria com que tudo o que fosse impresso no modo debug aparecesse 
	# na saída do nosso comando dentro do log. Para evitar isso, o descritor 3
	# redireciona a saída do set -x diretamente apenas para o stderr do próprio shell
	# fazendo que a saída do set -x apareça apenas no terminal e não no log

	exec 3>&2
	#Saída padrão do set -x
	BASH_XTRACEFD=3
	
	inicio=$(date +%s.%N)
	#incializa o modo debug
	debug_mode
	
	# Executa o comando e guarda sua saída ou seus erros dentro de um log
	"$nome_func" 2>&1 | tee -a "$nome_log"
	
	# encerra o modo debug
	end_mode
	
	fim=$(date +%s.%N)
	
	# Como o descritor 3 não será mais usado, podemos descartá-lo
	exec 3>&-
	
	# Tiramos a diferença entre o inicio do horário de sexecução
	# e do horário de fim da execução  para calcular o tempo 
	# total de execução
	
	tempo_real=$( echo "$fim - $inicio" | bc)
	
	# Para números menorres que 0.5, o bc pode retorná-los sem o 0 da 
	# primeria posição, por isso colocamos ele aqui
	if [[ "$tempo_real" == .* ]]; then 
		tempo_real="0$tempo_real"
	fi
	
	# Define o formato para números decimais usarem .
	# isso é importante pois o printf pode apresentar erros caso 
	# usemos um número decimal com , da formatação %.4f
	LC_NUMERIC=C printf -v tempo_real "%.4f" "$tempo_real"

	# Salva o tempo de execução do comando dentro de logs
	echo "Tempo Real de execução: ${tempo_real} s" >> "$nome_log"
	mv "$nome_log" logs
}

# Executa em modo debug todo comando chamado após debu_mode, caso o modo 
# debug tenha sido inicializado

# Executa a chamada dos cases em modo verboso, caso o modo verboso tenha sido
# inicializa-do
verbose_mode

# execução sem argumentos
if [[ $# -lt 1 ]]; then
    echo "Uso: cbuild [OPÇÃO...] [build | run | clean | rebuild | info]"
    exit 2
fi

for f in $@; do
    case $f in
        build)
            gerar_logs cbuild_build
            exit $?
            ;;
        run)
            gerar_logs cbuild_run
            exit $? 
            ;;
        clean)
            gerar_logs cbuild_clean
            exit $? 
            ;;
        rebuild)
            gerar_logs cbuild_rebuild
            exit $?
            ;;
        info)
            gerar_logs cbuild_info
            exit $? 
            ;;
        *)
            echo "ERRO: comando '$f' não reconhecido"
            exit 1 
            ;;
    esac
done
end_mode

# Guarda o horário de fim da execução em segundos e nanosegundos
exit 0
