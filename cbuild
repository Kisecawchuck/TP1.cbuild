#!/bin/bash

# lê arquivo de configuração
if [[ -e cbuild.conf ]]; then
	source cbuild.conf
else
	echo "ERRO: arquivo de configuração inexistente!"
	exit 5
fi

# CONSTANTES GLOBAIS
BUILD_DIR="$CBUILD_PATH/build"
LOGS_DIR="$CBUILD_PATH/logs"
SRC_DIR="$CBUILD_PATH/src"
RELATORIOS_DIR="$CBUILD_PATH/relatorios"
INCLUDE_DIR="$CBUILD_PATH/include"
SRCS=$(find $SRC_DIR -name "*.c" 2> /dev/null)

# Olha as flags passadas como argumentos e decide se o modo verboso ou debug será
# inicializado.
verbose='false'
debug='false'
run_args=''
while getopts "VDr:" flag; do
    case $flag in
        V) verbose='true' ;;
        D) debug='true' ;;
        r) run_args="${OPTARG}" ;;
        *)
            echo "Opção inesperada ${flag}"
            exit
            ;;
    esac
done
# shifta os argumentos já utilizados
shift $((OPTIND - 1))

verbose_mode() {
    # Executa todo comando excrito após a chamada função dentro do código
    # em modo verboso (até que set +v seja executado ou que o script termine)
    # caso a flag -V seja passada.

    if [[ $verbose = 'true' ]]; then
        set -v
    fi
}

debug_mode() {
    # Executa em modo debug todo comando chamado após a execuão dessa função
    # (até que set +x seja executado ou qu e o script termine) caso a flag -D seja 
    # passada.

    if [[ $debug = 'true' ]]; then
        set -x
    fi
}

end_mode() {
    # termina modo verboso
    if [[ $verbose = 'true' ]]; then
        set +v
    fi
    # termina modo debug
    if [[ $debug = 'true' ]]; then
        set +x
    fi
}

# A cada chamada das funções principais, será determinado se o 
# o modo verboso será executado ou não.
if [[ $1 = 'build' ]]; then 
    verbose_mode
fi

cbuild_build() {
    # verifica se $CC está instalado
    if [[ ! $(command -v $CC) ]]; then
        echo "ERRO: $CC não está instalado"
        return 2
    fi

    # verifica se build é um diretório
    if [[ ! -d $BUILD_DIR ]]; then
        mkdir $BUILD_DIR
    fi

    # verifica se há código-fonte no projeto
    if [[ ! -d $SRC_DIR || -z $SRCS ]]; then
        echo "ERRO: não há arquivos .c no projeto"
        return 3
    fi

    # transformamos cada arquivo código-fonte em objeto
        for SRC in $SRCS; do
        if [[ -e $SRC ]]; then
            # remove a extensão .c e adiciona a extensão .o
            OBJ=${SRC%.*}.o
            # remove src/ e adiciona build/
            OBJ=${BUILD_DIR}/${OBJ##*/}
            printf "$SRC:\n $CFLAGS -o $OBJ\n"
            $CC $CFLAGS -c $SRC -o $OBJ
        fi
    done

    # gera o executável principal
    local OBJS="${BUILD_DIR}/*.o"
    printf "main:\n $CFLAGS -o ${BUILD_DIR}/${TARGET}\n"
    $CC $CFLAGS $OBJS -o ${BUILD_DIR}/${TARGET}

    return 0
}
end_mode


if [[ $1 = 'run' ]]; then
    verbose_mode
fi
cbuild_run() {
	touch $BUILD_DIR/.last_run

    if [[ -d $BUILD_DIR && -e $BUILD_DIR/$TARGET ]]; then
        $BUILD_DIR/$TARGET $run_args
    else
        echo "ERRO: $BUILD_DIR/$TARGET inexistente"
        return 4
    fi
    return 0
}
end_mode


if [[ $1 = 'clean' ]]; then 
    verbose_mode
fi
cbuild_clean() {
	arquivos_log=$(ls $LOGS_DIR | sort )
	arquivos_build=$( ls $BUILD_DIR | sort)

	echo "====================================="
	echo "Apagando os seguintes arquivos:"

	echo "Pasta logs: "
	for i in ${arquivos_log[@]}; do
		echo "- $i"
	done

	echo " "

	echo "Pasta build: "
	for j in ${arquivos_build[@]}; do
		echo "- $j"
	done

	echo "====================================="
	rm -f $BUILD_DIR/* $LOGS_DIR/*

	return 0
}
end_mode


if [[ $1 = 'rebuild' ]]; then
    verbose_mode
fi
cbuild_rebuild() {
    # verifica se $CC está instalado
    if [[ ! $(command -v $CC) ]]; then
        echo "ERRO: $CC não está instalado"
        return 2
    fi

    # verifica se build é um diretório
    if [[ ! -d $BUILD_DIR ]]; then
        mkdir $BUILD_DIR
    fi
    # verifica se logs é um diretório
    if [[ ! -d $LOGS_DIR ]]; then
        mkdir $LOGS_DIR
    fi

    # verifica se há código-fonte no projeto
    if [[ ! -d $SRC_DIR || -z $SRCS ]]; then
        echo "ERRO: não há arquivos .c no projeto"
        return 3
    fi

    local OBJS="${BUILD_DIR}/*.o"

    local changed='false'
    for SRC in $SRCS; do
        # remove a extensão .c e adiciona .o
        OBJ=${SRC%.*}.o
        # remove src/ e adiciona build/
        OBJ=$BUILD_DIR/${OBJ##*/}
        # compara o timestamp de cada arquivo fonte com o seu objeto,
        # se o código-fonte é mais novo que o objeto, houve uma alteração
        # após a compilação;
        if [[ $SRC -nt $OBJ ]]; then
            printf "$SRC:\n $CFLAGS -o $OBJ\n"
            $CC $CFLAGS -c $SRC -o $OBJ
            changed='true'
        fi
    done

    # só recompilar a main se houve mudança
    if [[ $changed = 'true' ]]; then 
        printf "main:\n $CFLAGS -o $BUILD_DIR/$TARGET\n"
        # fixamos o executável final em build/main
        $CC $CFLAGS $OBJS -o $BUILD_DIR/$TARGET
    fi

    return 0
}
end_mode


gerar_logs() {
	# verifica se logs é um diretório
	if [[ ! -d $LOGS_DIR ]]; then
		mkdir $LOGS_DIR
	fi

	local data_hora=$(date '+%d-%m-%Y_%H-%M-%S')
	local nome_log="cbuild_$data_hora.txt"
	echo '' > "$nome_log"
	comando_exec=$1

	# Sem o descritor 3 redirecionado para &2, 
	# o rastro de set -x, com descritor padrão stderr(descritor 2), 
	# seria direcionado para o log na execução do comando com o tee
	# isso faria com que tudo o que fosse impresso no modo debug aparecesse 
	# na saída do nosso comando dentro do log. Para evitar isso, o descritor 3
	# redireciona a saída do set -x diretamente apenas para o stderr do próprio shell
	# fazendo que a saída do set -x apareça apenas no terminal e não no log

	exec 3>&2
	#Saída padrão do set -x
	BASH_XTRACEFD=3
	
	inicio=$(date +%s.%N)
	#incializa o modo debug
	debug_mode
	
	# Executa o comando e guarda sua saída ou seus erros dentro de um log
	"$comando_exec" 2>&1 | tee -a "temp_log.txt"

	# PIPESTATUS é um array que guarda a saída de retorno do comando executado
	# pelo tee em PIPESTATUS[0] e a saída do próprio tee em PIPESTATUS[1]
	
	codigo_retorno=${PIPESTATUS[0]}
	
	# encerra o modo debug
	end_mode
	
	fim=$(date +%s.%N)
	
	# Como o descritor 3 não será mais usado, podemos descartá-lo
	exec 3>&-

	saida_comando=$(cat "temp_log.txt")
	status="SUCESSO"

	if [[ $codigo_retorno -ne 0 ]]; then
		status="FALHA"
	fi
	# Tiramos a diferença entre o inicio do horário de sexecução
	# e do horário de fim da execução  para calcular o tempo 
	# total de execução
	tempo_real=$( echo "$fim - $inicio" | bc)

	# Para números menorres que 0.5, o bc pode retorná-los sem o 0 da 
	# primeria posição, por isso colocamos ele aqui
	if [[ "$tempo_real" == .* ]]; then 
		tempo_real="0$tempo_real"
	fi

	# Define o formato para números decimais usarem .
	# isso é importante pois o printf pode apresentar erros caso 
	# usemos um número decimal com , da formatação %.4f
	LC_NUMERIC=C printf -v tempo_real "%.4f" "$tempo_real"

	# Salva o tempo de execução do comando dentro de logs
	{
	echo "==========================================================="
    	echo "DATA/HORA DE EXECUÇÃO : $data_hora"
    	echo "COMANDO EXECUTADO : $comando_exec"
    	echo "TEMPO DE EXECUÇÃO : ${tempo_real}s"
    	echo "CÓDIGO DE RETORNO : $codigo_retorno"
    	echo "STATUS            : $status"
    	echo "-----------------------------------------------------------"
    	echo "SAÍDA DE CÓDIGO DE RETORNO/ERRO  (stdout/stderr):"
	echo "$saida_comando"
    	echo "==========================================================="
	echo ""
	} >>  "$nome_log"

	mv "$nome_log" $LOGS_DIR
	rm -f "temp_log.txt"

	return 0
}


if [[ $1 = 'info' ]]; then 
    verbose_mode
fi
cbuild_info() {
	# Coleta de Dados
	local formato_data_hora="+%d-%m-%Y_%H-%M-%S"
	local data_hora=$(date $formato_data_hora)
	local qtd_c=$(find $SRC_DIR -name "*.c" 2>/dev/null | wc -l)
	local qtd_h=$(find $INCLUDE_DIR -name "*.h" 2>/dev/null | wc -l)
	local linhas_c=0
	local linhas_h=0

	if [ $qtd_c -gt 0 ]; then
		linhas_c=$(find $SRC_DIR -name "*.c" -exec cat {} + 2>/dev/null | wc -l)
	fi
	if [ $qtd_h -gt 0 ]; then
		linhas_h=$(find $INCLUDE_DIR -name "*.h" -exec cat {} + 2>/dev/null | wc -l)
	fi
	local total_linhas=$((linhas_c + linhas_h))

	local tamanho="Indisponível"
	local data_compilacao="Indisponível"

	if [[ -f "$BUILD_DIR/$TARGET" ]]; then
		tamanho=$(du -h "$BUILD_DIR/$TARGET" | cut -f1)
		data_compilacao=$(date -r "$BUILD_DIR/$TARGET" $formato_data_hora)
	fi

	local data_execucao="Indisponível"
	if [[ -f "$BUILD_DIR/.last_run" ]]; then
		data_execucao=$(date -r "$BUILD_DIR/.last_run" $formato_data_hora)
	fi

	# Exibição na Tela (Terminal)
	echo "Arquivos fonte (.c): $qtd_c"
	echo "Arquivos de cabeçalho (.h): $qtd_h"
	echo "Total de linhas de código: $total_linhas"
	echo "Tamanho do executável: $tamanho"
	echo "Última compilação: $data_compilacao"
	echo "Última execução: $data_execucao"
	echo "---------------------------------------------"

	if [[ ! -d relatorios ]]; then
		mkdir $RELATORIOS_DIR
	fi
	local arquivo_relatorio="relatorios/relatorio_$data_hora.txt"
	{
		echo "========================================"
		echo "       RELATÓRIO DO PROJETO C           "
		echo "========================================"
		echo "Data do relatório: $data_hora"
		echo ""
		echo "--- ESTATÍSTICAS DOS ARQUIVOS ---"
		echo "Arquivos fonte (.c): $qtd_c"
		echo "Arquivos de cabeçalho (.h): $qtd_h"
		echo "Total de linhas de código: $total_linhas"
		echo ""
		echo "--- INFORMAÇÕES DE COMPILAÇÃO ---"
		echo "Tamanho do executável: $tamanho"
		echo "Última compilação: $data_compilacao"
		echo "Última execução: $data_execucao"
		echo "========================================"
	} > "$arquivo_relatorio"
	echo ">> Relatório detalhado gerado com sucesso em: $arquivo_relatorio"

	return 0
}
end_mode


# execução sem argumentos
if [[ $# -lt 1 ]]; then
	echo "Uso: cbuild [OPÇÃO...] {build | run | clean | rebuild | info }"
	exit 2
fi

#Executa em modo debug todo comando chamado após debu_mode, caso o modo 
# debug tenha sido inicializado
debug_mode

# Executa a chamada dos cases em modo verboso, caso o modo verboso tenha sido
# inicializa-do
verbose_mode

	
for f in $@; do
    case $f in
        build)
            gerar_logs cbuild_build
            exit $?
            ;;
        run)
            gerar_logs cbuild_run
            exit $? 
            ;;
        clean)
            gerar_logs cbuild_clean
            exit $? 
            ;;
        rebuild)
            gerar_logs cbuild_rebuild
            exit $?
            ;;
        info)
            gerar_logs cbuild_info
            exit $? 
            ;;
        *)
            echo "ERRO: comando '$f' não reconhecido"
            exit 1 
            ;;
    esac
done
end_mode

# Guarda o horário de fim da execução em segundos e nanosegundos
exit 0
