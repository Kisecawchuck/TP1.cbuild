#!/bin/bash

# podemos delegar uma função para cada pessoa, mas é importante que todos
# saibam como o código funciona por conta da demonstração;

# TODO: modo verboso 

# Lembrar: caso haja a utilização de flags nas funções implementadas, 
# principalmente se cada função requisitar um número de flags 
# diferentes, podemos chamar o comando $# que nos diz quantos argumentos
# foram passados na linha de comando. Isso será útil para diagnosticar 
# e evitar erros.


# Olha as flags passadas como argumentos e decidi se o modo verboso ou debug será
# inicializado.

verbose='false'
debug='false'
while getopts "VD" flag; do
        case $flag in
                V) verbose='true' ;;
                D) debug='true' ;;
                *)
                        echo "Opção inesperada ${flag}"
                        exit
                        ;;
        esac
done

verbose_mode() {
	# Executa todo comando excrito após a chamada função dentro do código
	# em modo verboso (até que set +v seja executado ou que o script termine)
	# caso a flag -V seja passada.

	if [[ $verbose = 'true' ]]; then
	        echo "Inciando modo verboso"
		set -v
	fi
}

debug_mode() {
	# Executa em modo debug todo comando chamado após a execuão dessa função
	# (até que set +x seja executado ou qu e o script termine) caso a flag -X seja 
	# passada.

	if [[ $debug = 'true' ]]; then
		echo "Iniciando modo debug"
		set -x
	fi
}

end_mode() {
	# Termina os códigos de debug e verboso, caso tenham sido inicializados

	if [[ $verbose = 'true' ]]; then
		set +v

	fi
	if [[ $debug = 'true' ]]; then
	        set +x
	fi
}

# A cada chamada das funções principais, será determinado se o 
# o modo verboso será executado ou não.

if [[ $2 == "build" ]]; then 
        verbose_mode
fi

cbuild_build() {
	# verifica se gcc está instalado
	if [[ ! $(command -v gcc) ]]; then
		echo "ERRO: GCC não está instalado"
		return 2
	fi

	# verifica se build é um diretório
	if [[ ! -d build ]]; then
		mkdir build
	fi
	# verifica se log é um diretório
	if [[ ! -d log ]]; then
		mkdir log
	fi

	# verifica se há código-fonte no projeto
	if [[ ! -d src || -z $(compgen -G src/*.c) ]]; then
		echo "ERRO: não há arquivos .c no projeto"
		return 3
	fi

	# transformamos cada cada arquivo código-fonte em objeto
	SRCS="src/*.c"
	BUILD="build"
	for SRC in $SRCS; do
		if [[ -e $SRC ]]; then
			# remove a extensão .c e adiciona a extensão .o
			OBJ=${SRC%.*}.o
			# remove src/ e adiciona build/
			OBJ=$BUILD/${OBJ##*/}
			printf "$SRC:\n -o $OBJ\n"
			gcc -c $SRC -o $OBJ
		fi
	done

	# fixamos o executável final em build/main
	TARGET="${BUILD}/main"
	OBJS="${BUILD}/*.o"
	printf "main:\n -o $TARGET\n"
	gcc $OBJS -o $TARGET

	return 0
}
end_mode

if [[ $2 == "run" ]]; then
	verbose_mode
fi

cbuild_run() {
	# TODO: passar flags para o run;
	if [[ -d ./build && -e ./build/main ]]; then
		build/main
	else
		echo "ERRO: ./build/main inexistente"
	fi
	return 0
}
end_mode

if [[ $2 == "clean" ]]; then 
	verbose_mode
fi

cbuild_clean() {
	rm -f build/* log/*
}
end_mode

# TODO: modo verboso

if [[ $2 == 'rebuild' ]]; then
        verbose_mode
fi

cbuild_rebuild() {
	SRCS="src/*.c"
	BUILD="build"
	TARGET="$BUILD/main"
	OBJS="${BUILD}/*.o"

	ch=false
	for SRC in $SRCS; do
		# remove a extensão .c e adiciona .o
		OBJ=${SRC%.*}.o
		# remove src/ e adiciona build/
		OBJ=$BUILD/${OBJ##*/}

		# compara o timestamp de cada arquivo fonte com o seu objeto
		if [[ $(date -r $SRC "+%s") -gt $(date -r $OBJ "+%s") ]]; then
			printf "$SRC:\n -o $OBJ\n"
			gcc -c $SRC -o $OBJ
			ch=true
		fi
	done

	# só recompilar a main se houve mudança
	if [[ $ch ==  true ]]; then 
		printf "main:\n -o $TARGET\n"
		# fixamos o executável final em build/main
		gcc $OBJS -o $TARGET
	fi

	return 0
}
end_mode

# TODO: modo verboso
if [[ $2 == 'info' ]]; then 
        verbose_mode
fi

cbuild_info() {
	# TODO: exibir quantidade de arquivos, linhas de código, tamanho do exe
	# cutável e datas da última compilação e execução;
	n=$(ls -1 | wc -l)
	return 0
}

end_mode

# execução sem argumentos
if [[ $# -lt 1 ]]; then
	echo "Uso: cbuild [OPÇÃO...] {build | run | clean | rebuild | info}"
	exit 2
fi

# Executa em modo debug todo comando chamado após debu_mode, caso o modo 
# debug tenha sido inicializado
debug_mode

# Executa a chamada dos cases em modo verboso, caso o modo verboso tenha sido
# inicializa-do
verbose_mode

for f in $@; do
	case $f in
		build)
			cbuild_build
			exit $? 
			;;
		run)
			cbuild_run
			exit $? 
			;;
		clean)
			cbuild_clean
			exit $? 
			;;
		rebuild)
			cbuild_rebuild
			exit $?
			;;
		info)
			cbuild_info
			exit $? 
			;;
		-*)
			;;
		*)
			echo "ERRO: comando '$f' não reconhecido"
			exit 1 
			;;
	esac
done
end_mode
