        mkdir ./build
    fi
    if [[ ! -d log ]]; then
        mkdir ./log
    fi

    if [[ -d src ]]; then
        SRCS="$(ls ./src/*.c)"
    fi
    if [[ ${#SRCS[@]} -le 0 ]]; then
        echo "Não há arquivos .c no projeto"
    else
        echo "$SRCS"
    fi
}

